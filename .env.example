# =============================================================================
# PrinZex environment variables — copy to .env.local for local development.
#
# Local databases (docker compose up -d) work out of the box with the defaults
# below. For the FREE-TIER cloud equivalents, create an account and paste your
# connection string over the matching value (all three have no-cost tiers):
#   PostgreSQL -> Neon  / Supabase
#   Redis      -> Upstash
#   MongoDB    -> MongoDB Atlas (M0)
# =============================================================================

# --- PostgreSQL (primary relational store) ---
# Local (docker-compose):
DATABASE_URL="postgresql://prinzex:prinzex@localhost:5432/prinzex?schema=public"
# Free-tier example (Neon):
# DATABASE_URL="postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/prinzex?sslmode=require"

# --- MongoDB (notifications, content, tickets) ---
# Local (docker-compose):
MONGODB_URI="mongodb://prinzex:prinzex@localhost:27017"
MONGODB_DB="prinzex"
# Free-tier example (Atlas M0):
# MONGODB_URI="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net"
# MONGODB_DB="prinzex"

# --- Redis (sessions, cache, rate limits) ---
# Local (docker-compose):
REDIS_URL="redis://localhost:6379"
# Free-tier example (Upstash):
# REDIS_URL="rediss://default:password@us1-xxxx.upstash.io:6379"

# --- Auth ---
# Generate a strong value: openssl rand -base64 32
JWT_SECRET="prinzex-dev-secret-change-me"

# --- Next.js ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
