# Server
NODE_ENV=development
PORT=5000

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/prinzex

# MongoDB
MONGODB_URI=mongodb://localhost:27017/prinzex

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change_this_secret_access
JWT_REFRESH_SECRET=change_this_secret_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File storage (stub for now)
AWS_BUCKET_NAME=prinzex-uploads
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email (stub for now)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

# Razorpay (live keys from the Razorpay dashboard; webhook secret set per endpoint)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Platform settings
PLATFORM_COMMISSION_RATE=0.12
# Minimum pending balance (in ₹) a seller needs before requesting a payout
MIN_PAYOUT_THRESHOLD=500
# Minimum pending earnings (in ₹) a delivery boy needs before requesting a payout
DELIVERY_MIN_PAYOUT_THRESHOLD=200

# CORS — comma-separated list of allowed frontend origins (Next.js app)
CORS_ORIGIN=http://localhost:3000
