# Server Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL (Prisma)
# Default for local Docker setup
DATABASE_URL="postgresql://postgres:password@localhost:5432/prinzex?schema=public"

# MongoDB (Mongoose)
# Default for local Docker setup
MONGODB_URI="mongodb://localhost:27017/prinzex"

# Redis (ioredis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Replace these with strong random strings in production)
JWT_ACCESS_SECRET="cATorNYxBYOG7CaldA9OKrITAg5nSZgLSPeZlfopL0E="
JWT_REFRESH_SECRET="K0TTx5Vyw+C8ZKM33A/sASVBeE2AFhoPxN+OCYjlyK4="
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS - Allowing the Next.js frontend
CORS_ORIGIN="http://localhost:3000"

# Razorpay (Fill these with your keys from Razorpay Dashboard)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Platform Settings
PLATFORM_COMMISSION_RATE=0.12
MIN_PAYOUT_THRESHOLD=500
DELIVERY_MIN_PAYOUT_THRESHOLD=200

# FCM push notifications (gap #10). Leave empty to disable push (in-app,
# socket and rider polling keep working). Fill these from a Firebase
# service-account JSON to enable order-update pushes:
#   FIREBASE_PROJECT_ID      = service account "project_id"
#   FIREBASE_CLIENT_EMAIL    = service account "client_email"
#   FIREBASE_PRIVATE_KEY     = service account "private_key" (its \n escapes are fine)
# FIREBASE_PRIVATE_KEY_FILE is an alternative to inlining the key (path to the
# JSON file — reads "private_key" from it at boot).
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_PRIVATE_KEY_FILE=""
