# The base URL for the backend API
NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# Optional: if you use a separate socket server URL
NEXT_PUBLIC_SOCKET_URL="http://localhost:5000"

# Razorpay Key ID (Public)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# FCM push notifications (gap #10). Leave empty to disable push — in-app
# notifications, socket events and rider polling all keep working.
# NEXT_PUBLIC_FIREBASE_CONFIG is the Firebase *web* app config as a JSON
# string (public by design). NEXT_PUBLIC_FCM_VAPID_KEY is the "Web Push
# certificates" key pair from Project settings → Cloud Messaging.
# After setting these, regenerate public/firebase-messaging-sw.js with:
#   NEXT_PUBLIC_FIREBASE_CONFIG='…' npx tsx scripts/generate-firebase-sw.ts
NEXT_PUBLIC_FIREBASE_CONFIG=""
NEXT_PUBLIC_FCM_VAPID_KEY=""
